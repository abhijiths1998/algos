# Copy this file to .env and fill in ONE provider's settings.
# .env is git-ignored, so your keys never get committed.

# callmebot (default, free, easiest) | twilio | meta
WHATSAPP_PROVIDER=callmebot

# --- CallMeBot ---
# Your number with country code, no + or spaces, e.g. 919876543210
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=whatsapp:+14155238886
TWILIO_TO=whatsapp:+91XXXXXXXXXX

# --- Meta WhatsApp Cloud API ---
META_TOKEN=
META_PHONE_NUMBER_ID=
META_TO=91XXXXXXXXXX
