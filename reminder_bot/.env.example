# Copy this file to .env and fill in ONE provider's settings.
# .env is git-ignored, so your keys never get committed.

# telegram (default) | callmebot | twilio | meta
REMINDER_PROVIDER=telegram

# --- Telegram ---
# Token from @BotFather. Chat ID: send your bot /start, then run `python bot.py chatid`.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- CallMeBot (WhatsApp) ---
# Your number with country code, no + or spaces, e.g. 919876543210
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# --- Twilio (WhatsApp) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=whatsapp:+14155238886
TWILIO_TO=whatsapp:+91XXXXXXXXXX

# --- Meta WhatsApp Cloud API ---
META_TOKEN=
META_PHONE_NUMBER_ID=
META_TO=91XXXXXXXXXX
